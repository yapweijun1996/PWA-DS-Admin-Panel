      "dark": "color-mix(in srgb, var(--accent-contrast) 14%, transparent)"
    },
    "surface-glass": {
      "light": "color-mix(in srgb, var(--surface) calc(var(--surface-alpha) * 100%), transparent)",
      "dark": "color-mix(in srgb, var(--surface) calc(var(--surface-alpha) * 100%), transparent)"
    },
    "ambient-start": {
      "light": "color-mix(in srgb, var(--accent-soft) 70%, var(--bg))",
      "dark": "color-mix(in srgb, var(--accent-soft) 70%, var(--bg))"
    },
    "ambient-end": {
